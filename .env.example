# Copie para .env e preencha. Nunca versione o .env.
PORT=3333
DATABASE_URL=postgres://zelo:zelo@localhost:5432/zelo

# Assina os tokens de login (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
# Segredo do hash do CPF e do código de pareamento. Se trocar, os CPFs já
# cadastrados deixam de bater: defina uma vez e guarde em local seguro.
HASH_PEPPER=troque-por-outro-segredo-longo-e-diferente-do-jwt

# Fuso usado nos horários das doses
APP_TIMEZONE=America/Sao_Paulo
# Prefixo do link de convite (o token é colocado no final).
# zelo://invite abre o app (precisa do "scheme": "zelo" no app.json). Com domínio próprio: https://seudominio.com/invite
INVITE_BASE_URL=zelo://invite
# Origem liberada no CORS (use * só em desenvolvimento)
CORS_ORIGIN=*

# Regras das doses (minutos)
DOSE_ON_TIME_MINUTES=15
DOSE_MISSED_AFTER_MINUTES=30
